# Netlify environment variables for DisputeForensic.com
# Set these in Netlify → Site configuration → Environment variables

NEXT_PUBLIC_SITE_URL=https://www.disputeforensic.com

# Lead delivery (at least one required for form submissions to succeed)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet12
Lead_notification_url=
# LEAD_NOTIFICATION_URL=

# Optional fallback if API route returns 503
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
