# Netlify environment variables — see Lead_notification_setup.md

NEXT_PUBLIC_SITE_URL=https://www.disputeforensic.com

# n8n webhook (optional if Google Sheets is configured)
Lead_notification_url=
# LEAD_NOTIFICATION_URL=

# Google Sheets — required for sheet logging (share sheet with service account email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste PEM as one line with \n for newlines, or use Netlify multiline value
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Sheet1

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
